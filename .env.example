# Required. Create an app at https://trakt.tv/oauth/applications
# Public read-only endpoints only need the client ID (no secret, no OAuth).
TRAKT_CLIENT_ID=

# Required. Your Trakt username (or "me" once OAuth is wired up).
TRAKT_USERNAME=

# Optional
# TRAKT_APP_ID=
# TRAKT_IFY_DATA_DIR=data

# Required only for `trakt-ify describe` (cluster naming via Claude).
# ANTHROPIC_API_KEY=

# Optional. Identifies your deployment to Trakt via User-Agent.
# TRAKT_IFY_USER_AGENT=
